"""
BUILD.bazel for @tummycrypt/tinyland-stores.

  Bazel:      bazel build //:pkg && bazel test //...
  Consumers:  bazel_dep(name = "tummycrypt_tinyland_stores", version = "1.0.0")
              from xoxd-ai/bazel-registry; the package is not published to npm.
              See README.md for the npm_link_package recipe.

The sources are .ts and .svelte.ts modules only (no .svelte components), so
TypeScript 7.0.2 compiles them directly: foo.svelte.ts emits foo.svelte.js with
the runes left in place for the consumer's Svelte compiler, plus
foo.svelte.d.ts. This replaces svelte-package, whose svelte2tsx emitDts does
not run on TypeScript 7 (RU13). The rune globals come from the svelte types
(tsconfig "types": ["svelte"]).

The in-house dependencies resolve through the Bazel module graph only, so the
type check and the tests run under Bazel rather than plain pnpm.
"""

load("@aspect_rules_js//npm:defs.bzl", "npm_link_package", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@tummycrypt_tinyland_stores_npm//:defs.bzl", "npm_link_all_packages")
load("@tummycrypt_tinyland_stores_npm//:vitest/package_json.bzl", vitest_bin = "bin")

# =============================================================================
# npm links
# =============================================================================

npm_link_all_packages(name = "node_modules")

# First-party deps from the Bazel module graph (not npm). Each is linked from
# its module's :pkg target and kept out of package.json. svelte is a peer of
# all of them and resolves to this package's own node_modules/svelte, so there
# is a single svelte instance.
npm_link_package(
    name = "node_modules/@tummycrypt/tinyland-composables",
    src = "@tummycrypt_tinyland_composables//:pkg",
)

npm_link_package(
    name = "node_modules/@tummycrypt/tinyvectors",
    src = "@tummycrypt_tinyvectors//:pkg",
)

# tinyland-a11y-engine 1.0.0 carries no npm links of its own; its runtime
# dependency color-utils is linked here and passed in as `deps` (see the engine
# README).
npm_link_package(
    name = "node_modules/@tummycrypt/tinyland-color-utils",
    src = "@tummycrypt_tinyland_color_utils//:pkg",
)

npm_link_package(
    name = "node_modules/@tummycrypt/tinyland-a11y-engine",
    src = "@tummycrypt_tinyland_a11y_engine//:pkg",
    deps = {
        ":.aspect_rules_js/node_modules/@tummycrypt/tinyland-color-utils": "@tummycrypt/tinyland-color-utils",
    },
)

FIRST_PARTY_LINKS = [
    ":node_modules/@tummycrypt/tinyland-a11y-engine",
    ":node_modules/@tummycrypt/tinyland-color-utils",
    ":node_modules/@tummycrypt/tinyland-composables",
    ":node_modules/@tummycrypt/tinyvectors",
]

SRCS = glob(
    ["src/**/*.ts"],
    exclude = [
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
    ],
)

# =============================================================================
# TypeScript compilation (TypeScript 7.0.2, native)
# =============================================================================

ts_project(
    name = "tinyland_stores",
    srcs = SRCS + ["package.json"],
    declaration = True,
    declaration_map = True,
    source_map = False,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    out_dir = "dist",
    root_dir = "src",
    validate = False,
    deps = [":node_modules/svelte"] + FIRST_PARTY_LINKS,
    visibility = ["//visibility:public"],
)

# Plain output files only. svelte is a peer and the first-party modules are
# linked by the consumer, so the package must not carry this repo's npm store
# links (a link carried from another Bazel repo points into external/<repo>,
# which is missing from a consumer's runfiles under Bazel 8).
# DefaultInfo holds the .js files; the declarations (.d.ts, .d.ts.map) are in
# the ts_project "types" output group, so both are listed.
filegroup(
    name = "dist",
    srcs = [":tinyland_stores"],
)

filegroup(
    name = "dist_types",
    srcs = [":tinyland_stores"],
    output_group = "types",
)

# =============================================================================
# npm package target
# =============================================================================

npm_package(
    name = "pkg",
    srcs = [
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
        "package.json",
        ":dist",
        ":dist_types",
    ],
    package = "@tummycrypt/tinyland-stores",
    version = "1.0.0",
    visibility = ["//visibility:public"],
)

# =============================================================================
# Test targets
# =============================================================================

vitest_bin.vitest_test(
    name = "test",
    data = [
        ":node_modules",
        "package.json",
        "tsconfig.json",
        ":node_modules/vitest",
        "vitest.config.ts",
    ] + FIRST_PARTY_LINKS + glob(["src/**/*.ts"]) + glob(["tests/**/*.ts"]),
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    log_level = "info",
    visibility = ["//visibility:public"],
)

# =============================================================================
# Typecheck-only target (no emit). `bazel test //...` runs it as
# //:typecheck_typecheck_test; `bazel build //:typecheck` alone builds nothing.
# =============================================================================

ts_project(
    name = "typecheck",
    srcs = SRCS + ["package.json"],
    declaration = False,
    no_emit = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    validate = False,
    deps = [":node_modules/svelte"] + FIRST_PARTY_LINKS,
    visibility = ["//visibility:public"],
)

# =============================================================================
# Exported files for downstream consumers
# =============================================================================

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)
