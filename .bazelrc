common --enable_bzlmod
# In-house modules come from xoxd-ai/bazel-registry, pinned to a commit so the
# registry bytes recorded in MODULE.bazel.lock cannot move under us (RU6). The
# former tinyland-inc registry line is gone: that org redirects to xoxd-ai.
common --registry=https://raw.githubusercontent.com/xoxd-ai/bazel-registry/aedc47769da5e367432afe8355177b0a87960468
common --registry=https://bcr.bazel.build

build --jobs=auto
build --worker_sandboxing
build --disk_cache=~/.cache/bazel-tinyland-stores
build --show_timestamps
build --@aspect_rules_ts//ts:skipLibCheck=always

test --test_output=errors
test --test_timeout=120,600,1800,3600

build:ci --color=no
build:ci --curses=no
build:ci --noshow_loading_progress
test:ci --test_output=errors

try-import %workspace%/user.bazelrc
