module(
    name = "tummycrypt_tinyland_stores",
    version = "1.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "aspect_rules_js", version = "2.9.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_nodejs", version = "6.7.3")

# In-house modules from xoxd-ai/bazel-registry, linked in BUILD.bazel with
# npm_link_package. They are not in package.json (RU6: Bazel-only distribution).
#   - tinyland-composables: autosave store helpers (useEditorQueue)
#   - tinyvectors:          getThemeCatalog() for the theme catalog
#   - tinyland-a11y-engine: browser a11y detection (the ./browser subpath)
#   - tinyland-color-utils: runtime dependency of tinyland-a11y-engine, linked
#                           here and passed to the engine link as `deps`
bazel_dep(name = "tummycrypt_tinyland_a11y_engine", version = "1.0.0")
bazel_dep(name = "tummycrypt_tinyland_color_utils", version = "1.0.0")
bazel_dep(name = "tummycrypt_tinyland_composables", version = "1.0.0")
bazel_dep(name = "tummycrypt_tinyvectors", version = "1.0.0")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.22.0")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "10.13.1",
)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "tummycrypt_tinyland_stores_npm",
    data = [
        "//:package.json",
        "//:pnpm-workspace.yaml",
    ],
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "tummycrypt_tinyland_stores_npm")

# TypeScript 7.0.2 (native compiler) per RU1/RU13. rules_ts >= 3.9.0 knows the
# native package integrities; ts_project must set transpiler = "tsc".
typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(version = "7.0.2")
use_repo(typescript, "npm_typescript")
