{
  "name": "@tummycrypt/tinyland-stores",
  "version": "1.0.0",
  "private": true,
  "description": "Svelte 5 reactive stores for authentication, theming, CSRF, observability, and accessibility state management",
  "type": "module",
  "license": "Zlib AND LicenseRef-Tinyland-Proprietary",
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint"
  },
  "keywords": [
    "svelte5",
    "runes",
    "stores",
    "reactive",
    "theme",
    "auth",
    "csrf",
    "observability",
    "circuit-breaker",
    "accessibility"
  ],
  "author": "Tinyland.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoxd-ai/tinyland-stores.git"
  },
  "peerDependencies": {
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "happy-dom": "^20.14.6",
    "publint": "^0.3.25",
    "svelte": "5.57.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/xoxd-ai/tinyland-stores",
  "bugs": {
    "url": "https://github.com/xoxd-ai/tinyland-stores/issues"
  }
}
